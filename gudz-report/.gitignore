# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit a real one. The example is the exception: it is the
# only place the required variable names are written down, and it holds no value.
.env
.env.*
!.env.example

# Local Convex backend: the downloaded binary and this machine's database.
# Machine-specific state, not source — and it holds real imported client data.
.convex/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
